# Normalize line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Windows-only scripts must stay CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# The Maven wrapper shell script must stay LF even on Windows checkouts.
mvnw text eol=lf

# Binary assets — never touch line endings.
*.jar   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
